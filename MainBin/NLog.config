<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<targets>
		<!-- 
      目标1: Process 日志文件 
      路径：MainBin/logs/Process/2026-08-18.log
    -->
		<target xsi:type="File"
				name="processFile"
				fileName="${basedir}/logs/Process/${shortdate}.log"
				layout="${longdate} ${level:uppercase=true} ${message}"
				encoding="utf-8">
			<!-- 修正：正确的归档配置标签 -->
			<maxArchiveFiles>10</maxArchiveFiles>
			<archiveEvery>Day</archiveEvery>
			<archiveAboveSize>31457280</archiveAboveSize>
			<!-- 30MB = 30 * 1024 * 1024 -->
			<archiveFileName>${basedir}/logs/Process/archives/${shortdate}.{#}.log</archiveFileName>
			<archiveNumbering>Rolling</archiveNumbering>
		</target>

		<!-- 
      目标2: Other 日志文件 
      路径：MainBin/logs/Other/2026-08-18.log
    -->
		<target xsi:type="File"
				name="otherFile"
				fileName="${basedir}/logs/Other/${shortdate}.log"
				layout="${longdate} ${level:uppercase=true} ${message}"
				encoding="utf-8">
			<!-- 修正：正确的归档配置标签 -->
			<maxArchiveFiles>10</maxArchiveFiles>
			<archiveEvery>Day</archiveEvery>
			<archiveAboveSize>31457280</archiveAboveSize>
			<!-- 30MB -->
			<archiveFileName>${basedir}/logs/Other/archives/${shortdate}.{#}.log</archiveFileName>
			<archiveNumbering>Rolling</archiveNumbering>
		</target>

	</targets>

	<rules>
		<!-- 
      规则1: 将所有名字为 "Process" 的 Logger 的日志，写入 processFile 目标 
      final="true" 表示匹配后不再继续匹配下面的规则，防止日志重复写入
    -->
		<logger name="Process" minlevel="Info" writeTo="processFile" final="true" />

		<!-- 
      规则2: 将所有名字为 "Other" 的 Logger 的日志，写入 otherFile 目标 
    -->
		<logger name="Other" minlevel="Info" writeTo="otherFile" final="true" />

		<!-- 你可以保留一个通配符规则，用于捕获其他未定义的日志 -->
		<!-- <logger name="*" minlevel="Debug" writeTo="someOtherTarget" /> -->
	</rules>
</nlog>
