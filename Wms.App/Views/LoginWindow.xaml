<mah:MetroWindow
    x:Class="Wms.App.Views.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wms.App.Views"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:iconPack="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:account="clr-namespace:Wms.Core.Consts;assembly=Wms.Core"
    xmlns:prism="http://prismlibrary.com/"
    Width="800"
    Height="500"
    prism:ViewModelLocator.AutoWireViewModel="True"
    ShowIconOnTitleBar="True"
    ResizeMode="NoResize"
    Style="{DynamicResource MahApps.Styles.MetroWindow.Clean}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Clean/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- 背景遮罩 -->
        <Grid Background="White" Opacity="0.85">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <!-- 左侧装饰区域 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 科技感装饰圆环 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Viewbox Grid.Column="1" Width="200" Height="200">
                        <Canvas Width="200" Height="200">
                            <!-- 外层圆环 -->
                            <Ellipse Width="180" Height="180" Canvas.Left="10" Canvas.Top="10"
                                     Stroke="#0078D7" StrokeThickness="1" Opacity="0.3" />
                            <!-- 中层圆环 -->
                            <Ellipse Width="140" Height="140" Canvas.Left="30" Canvas.Top="30"
                                     Stroke="#00B4D8" StrokeThickness="1" Opacity="0.5" />
                            <!-- 内层圆环 -->
                            <Ellipse Width="100" Height="100" Canvas.Left="50" Canvas.Top="50"
                                     Stroke="#48CAE4" StrokeThickness="2" Opacity="0.7" />
                            <!-- 中心图标 -->
                            <iconPack:PackIconMaterial Kind="Network" Width="50" Height="50"
                                                       Canvas.Left="75" Canvas.Top="75"
                                                       Foreground="#0078D7" />
                            <!-- 连接线 -->
                            <Line X1="70" Y1="70" X2="30" Y2="30" Stroke="#0078D7" StrokeThickness="1" Opacity="0.4" />
                            <Line X1="130" Y1="70" X2="170" Y2="30" Stroke="#0078D7" StrokeThickness="1" Opacity="0.4" />
                            <Line X1="70" Y1="130" X2="30" Y2="170" Stroke="#0078D7" StrokeThickness="1" Opacity="0.4" />
                            <Line X1="130" Y1="130" X2="170" Y2="170" Stroke="#0078D7" StrokeThickness="1" Opacity="0.4" />
                        </Canvas>
                    </Viewbox>
                </Grid>

                <!-- 底部文字 -->
                <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,60">
                    <TextBlock Text="WMS 智能仓储管理系统" FontSize="24" FontWeight="Bold" Foreground="#0078D7" />
                    <TextBlock Text="高效 · 智能 · 便捷" FontSize="14" Foreground="#666666" Margin="0,5,0,0" />
                </StackPanel>
            </Grid>

            <!-- 右侧登录区域 -->
            <Grid Grid.Column="1" Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="80" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <iconPack:PackIconMaterial Kind="Login" Width="48" Height="48" Foreground="#0078D7" HorizontalAlignment="Center" />
                    <TextBlock Text="欢迎登录" FontSize="28" FontWeight="Bold" Foreground="#333333" Margin="0,10,0,0" />
                    <TextBlock Text="请输入您的账号信息" FontSize="14" Foreground="#999999" Margin="0,5,0,0" />
                </StackPanel>

                <!-- 用户名输入框 -->
                <StackPanel Grid.Row="2" Margin="40,20,40,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="45" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#F5F7FA" CornerRadius="8,0,0,8"
                                VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                            <iconPack:PackIconMaterial Kind="Account" Width="22" Height="22"
                                                       Foreground="#0078D7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBox Grid.Column="1"
                                 Style="{DynamicResource LoginTextBoxStyle}"
                                 Margin="0,0,0,0"
                                 mah:TextBoxHelper.ClearTextButton="True"
                                 mah:TextBoxHelper.Watermark="请输入用户名"
                                 Text="{Binding UserName}" />
                    </Grid>
                </StackPanel>

                <!-- 密码输入框 -->
                <StackPanel Grid.Row="3" Margin="40,15,40,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="45" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#F5F7FA" CornerRadius="8,0,0,8"
                                VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                            <iconPack:PackIconMaterial Kind="Lock" Width="22" Height="22"
                                                       Foreground="#0078D7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <PasswordBox Grid.Column="1"
                                     Name="PasswordBox"
                                     Style="{DynamicResource LoginPasswordBoxStyle}"
                                     Margin="0,0,0,0"
                                     mah:PasswordBoxBindingBehavior.Password="{Binding Password}"
                                     mah:TextBoxHelper.ClearTextButton="True"
                                     mah:TextBoxHelper.Watermark="请输入密码" />
                    </Grid>
                </StackPanel>

                <!-- 错误提示 -->
                <StackPanel Grid.Row="4" Margin="40,0,40,0">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Style="{DynamicResource ErrorMessageStyle}"
                               Visibility="{Binding IsErrorVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <!-- 登录按钮 -->
                <StackPanel Grid.Row="5" Margin="40,20,40,0">
                    <Button Style="{DynamicResource LoginButtonStyle}"
                            Command="{Binding LoginCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=mah:MetroWindow}}"
                            Content="登 录"
                            IsDefault="True" />
                </StackPanel>

                <!-- 底部版权 -->
                <StackPanel Grid.Row="6" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20">
                    <TextBlock Text="© 2026 WMS Management System" FontSize="12" Foreground="#CCCCCC" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</mah:MetroWindow>